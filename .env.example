# Verity environment — copy to `.env` and fill in:  cp .env.example .env
#
# The offline test suite needs NO secrets. A key is required only for the LIVE
# feature-engineering demo (real Claude proposals scored in a container). The
# container sandbox forwards this var into each per-cycle container.
ANTHROPIC_API_KEY=sk-ant-...

# --- Kaggle (only for the `fe-kaggle` task — the real-leaderboard final-test gate) ---
# Create an API token at https://www.kaggle.com/settings -> "Create New Token" (downloads
# kaggle.json); copy its "username" and "key" here. The control-plane daemon reads these and submits
# on the trusted verifier side — they are NEVER forwarded to a worker. You must also ACCEPT the
# competition's rules on its Kaggle page once (the API returns 403 otherwise). Leave blank to skip;
# the `@kaggle` live test and the fe-kaggle live run auto-skip without them.
KAGGLE_USERNAME=
KAGGLE_KEY=
# The competition the fe-kaggle task submits to (the stellar Playground Series).
KAGGLE_COMPETITION=playground-series-s6e6
