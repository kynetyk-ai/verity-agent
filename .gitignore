# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Node (agent-loop tooling, if used)
node_modules/
npm-debug.log*

# Env / secrets
.env
.env.*
!.env.example

# Durable state (store / object-blobs) — not source
*.sqlite
*.sqlite3
*.db
/store/
store/

# ---------------------------------------------------------------------------
# Third-party datasets — NEVER committed. We hold access rights to the Kaggle
# competition data; we hold no right to redistribute it. This repo may go
# public, so the rules below are deliberately broad and extension-based rather
# than path-anchored: a dataset dropped in a new directory must be ignored by
# default, not by remembering to add a path. Tracking a data file requires an
# explicit `!` exception here and a deliberate answer to "may we publish this?".
# ---------------------------------------------------------------------------
data/
*.csv
*.tsv
*.parquet
*.feather
*.arrow
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.pickle
*.xlsx
*.zip
*.csv.gz
*.tsv.gz
*.json.gz
*.jsonl
*.ndjson

# results/ is a local sweep-output SCRATCH dir — the committed experimental record + analysis now
# live in the sibling `verity-analysis` repo (finished batches are pulled over with
# verity-analysis/scripts/import_results.sh). Ignore everything under results/ EXCEPT the
# prototyping_datasci_test task package, which stays tracked (PROTOCOL.md / task.json / run.sh, ADR
# 0005-linked) with only its large datasets + generated output excluded. figures/ is analysis output.
/results/*
!/results/.gitkeep
!/results/prototyping_datasci_test/
/results/prototyping_datasci_test/*.csv
/results/prototyping_datasci_test/out/
/results/prototyping_datasci_test/agent/
/results/prototyping_datasci_test/verifier/
/figures/
figures/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
