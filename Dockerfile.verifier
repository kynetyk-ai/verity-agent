# The Verity verifier service image (ROADMAP Phase 7.1/7.2). Build from the REPO ROOT:
#
#   docker build -f Dockerfile.verifier -t verity-verifier:latest .
#
# Runs the advisory verifier as a standing HTTP service (entrypoint `python -m verity.verifier`,
# default port 8001) that the control plane dispatches to via verifier_key="remote". Carries the gate
# SDK + the LLM-judge's `anthropic` (core deps) + the `service` extra (FastAPI/uvicorn/httpx) — but
# NOT deepagents/langchain (those are the sandbox's).
#
# Since §9.1 this image OWNS the data-bearing fe-kaggle verifier: it carries the FE gates and the
# `kaggle` extra (the real-leaderboard final-test gate), and its `BackendCodeRunner` launches its own
# code-runner *sibling* containers, so it needs the docker CLI + a mounted /var/run/docker.sock.
# `VERITY_VERIFIER=fe-kaggle` selects it; the control plane ships the per-task data over the wire and
# the Kaggle creds are passed only to THIS container — never the control-plane image or an agent.
FROM python:3.12-slim

# The docker CLI only (no engine) — the BackendCodeRunner drives the mounted host socket to launch
# code-runner sibling workers.
COPY --from=docker:cli /usr/local/bin/docker /usr/local/bin/docker
# uv for a faithful reproduction of the dev environment (same lockfile).
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app
COPY . /app

# Bake core + `service` (transport) + `kaggle` (the FE real-leaderboard gate) into a venv — no
# dev/test deps, no sandbox/model libs.
RUN uv sync --frozen --no-dev --extra service --extra kaggle

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

EXPOSE 8001
ENTRYPOINT ["python", "-m", "verity.verifier"]
