# The Verity verifier service image (ROADMAP Phase 7.1/7.2). Build from the REPO ROOT:
#
#   docker build -f Dockerfile.verifier -t verity-verifier:latest .
#
# Runs the advisory verifier as a standing HTTP service (entrypoint `python -m verity.verifier`,
# default port 8001) that the control plane dispatches to via verifier_key="remote". Carries the gate
# SDK + the LLM-judge's `anthropic` (core deps) + the `service` extra (FastAPI/uvicorn/httpx) — but
# NOT deepagents/langchain (those are the sandbox's). A verifier whose gates run submitted code
# (feature-engineering) additionally needs the docker CLI + a mounted /var/run/docker.sock for the
# ContainerCodeRunner, or the code runner as a sibling service — wired when that domain is served.
FROM python:3.12-slim

# uv for a faithful reproduction of the dev environment (same lockfile).
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app
COPY . /app

# Bake core + the service (transport) extra into a venv — no dev/test deps, no sandbox/model libs.
RUN uv sync --frozen --no-dev --extra service

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

EXPOSE 8001
ENTRYPOINT ["python", "-m", "verity.verifier"]
