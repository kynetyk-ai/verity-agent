# The Verity sandbox image (ROADMAP Phase 3, Sprint 2). Build from the REPO ROOT:
#
#   docker build -f Dockerfile.sandbox -t verity-sandbox:latest .
#
# The container driver (verity.sandbox.container_driver) runs it per cycle as a non-root,
# caps-dropped, read-only-root container with /work mounted writable and outbound network for the
# model API, entrypoint `python -m verity.sandbox.container_entry`. A domain that needs extra runtime
# libraries (pandas, scikit-learn, ...) extends this image.
FROM python:3.12-slim

# uv for a faithful reproduction of the dev environment (same lockfile).
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app
COPY . /app

# Bake core + the sandbox extra into a venv in the image (no dev/test deps).
RUN uv sync --frozen --no-dev --extra sandbox

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Mount points the container driver binds at runtime (world-writable so any host uid can write).
RUN mkdir -p /work /sandbox && chmod 0777 /work /sandbox

# No ENTRYPOINT: the container driver supplies `python -m verity.sandbox.container_entry`.
